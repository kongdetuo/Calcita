<ResourceDictionary xmlns="https://github.com/avaloniaui"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:sys="using:System">
	<ResourceDictionary.ThemeDictionaries>
		<ResourceDictionary x:Key="Default">
			<Color x:Key="CalcitaBackgroundColor">#FFFFFFFF</Color>
			<Color x:Key="CalcitaBorderLowColor">#FFAAAAAA</Color>
			<Color x:Key="CalcitaBorderMidColor">#FF888888</Color>
			<Color x:Key="CalcitaBorderHighColor">#FF333333</Color>
			<Color x:Key="CalcitaControlLowColor">#FF868999</Color>
			<Color x:Key="CalcitaControlMidColor">#FFF5F5F5</Color>
			<Color x:Key="CalcitaControlMidHighColor">#FFC2C3C9</Color>
			<Color x:Key="CalcitaControlHighColor">#FF686868</Color>
			<Color x:Key="CalcitaControlVeryHighColor">#FF5B5B5B</Color>
			<Color x:Key="CalcitaControlHighlightLowColor">#FFF0F0F0</Color>
			<Color x:Key="CalcitaControlHighlightMidColor">#FFD0D0D0</Color>
			<Color x:Key="CalcitaControlHighlightHighColor">#FF808080</Color>
			<Color x:Key="CalcitaForegroundColor">#FF000000</Color>
			<Color x:Key="CalcitaHighlightColor">#FF086F9E</Color>
			<Color x:Key="CalcitaHighlightColor2">#FF096085</Color>
			<Color x:Key="CalcitaHyperlinkVisitedColor">#FF681DA8</Color>

			<SolidColorBrush x:Key="CalcitaBackgroundBrush" Color="{StaticResource CalcitaBackgroundColor}" />
			<SolidColorBrush x:Key="CalcitaBorderLowBrush" Color="{StaticResource CalcitaBorderLowColor}" />
			<SolidColorBrush x:Key="CalcitaBorderMidBrush" Color="{StaticResource CalcitaBorderMidColor}" />
			<SolidColorBrush x:Key="CalcitaBorderHighBrush" Color="{StaticResource CalcitaBorderHighColor}" />
			<SolidColorBrush x:Key="CalcitaControlLowBrush" Color="{StaticResource CalcitaControlLowColor}" />
			<SolidColorBrush x:Key="CalcitaControlMidBrush" Color="{StaticResource CalcitaControlMidColor}" />
			<SolidColorBrush x:Key="CalcitaControlMidHighBrush" Color="{StaticResource CalcitaControlMidHighColor}" />
			<SolidColorBrush x:Key="CalcitaControlHighBrush" Color="{StaticResource CalcitaControlHighColor}" />
			<SolidColorBrush x:Key="CalcitaControlVeryHighBrush" Color="{StaticResource CalcitaControlVeryHighColor}" />
			<SolidColorBrush x:Key="CalcitaControlHighlightLowBrush" Color="{StaticResource CalcitaControlHighlightLowColor}" />
			<SolidColorBrush x:Key="CalcitaControlHighlightMidBrush" Color="{StaticResource CalcitaControlHighlightMidColor}" />
			<SolidColorBrush x:Key="CalcitaControlHighlightHighBrush" Color="{StaticResource CalcitaControlHighlightHighColor}" />
			<SolidColorBrush x:Key="CalcitaForegroundBrush" Color="{StaticResource CalcitaForegroundColor}" />
			<SolidColorBrush x:Key="CalcitaHighlightBrush" Color="{StaticResource CalcitaHighlightColor}" />
			<SolidColorBrush x:Key="CalcitaHighlightBrush2" Color="{StaticResource CalcitaHighlightColor2}" />

			<SolidColorBrush x:Key="CalcitaTabSelectedBackgroundBrush" Color="{StaticResource CalcitaBackgroundColor}" />

		</ResourceDictionary>
		<ResourceDictionary x:Key="Dark">
			<Color x:Key="CalcitaBackgroundColor">#FF282828</Color>
			<Color x:Key="CalcitaBorderLowColor">#FF505050</Color>
			<Color x:Key="CalcitaBorderMidColor">#FF808080</Color>
			<Color x:Key="CalcitaBorderHighColor">#FFA0A0A0</Color>
			<Color x:Key="CalcitaControlLowColor">#FF282828</Color>
			<Color x:Key="CalcitaControlMidColor">#FF505050</Color>
			<Color x:Key="CalcitaControlMidHighColor">#FF686868</Color>
			<Color x:Key="CalcitaControlHighColor">#FF808080</Color>
			<Color x:Key="CalcitaControlVeryHighColor">#FFEFEBEF</Color>
			<Color x:Key="CalcitaControlHighlightLowColor">#FFA8A8A8</Color>
			<Color x:Key="CalcitaControlHighlightMidColor">#FF828282</Color>
			<Color x:Key="CalcitaControlHighlightHighColor">#FF505050</Color>
			<Color x:Key="CalcitaForegroundColor">#FFDEDEDE</Color>
			<Color x:Key="CalcitaHighlightColor">#FF119EDA</Color>
			<Color x:Key="CalcitaHighlightColor2">#FF096085</Color>
			<Color x:Key="CalcitaHyperlinkVisitedColor">#FFC58AF9</Color>

			<SolidColorBrush x:Key="CalcitaBackgroundBrush" Color="{StaticResource CalcitaBackgroundColor}" />
			<SolidColorBrush x:Key="CalcitaBorderLowBrush" Color="{StaticResource CalcitaBorderLowColor}" />
			<SolidColorBrush x:Key="CalcitaBorderMidBrush" Color="{StaticResource CalcitaBorderMidColor}" />
			<SolidColorBrush x:Key="CalcitaBorderHighBrush" Color="{StaticResource CalcitaBorderHighColor}" />
			<SolidColorBrush x:Key="CalcitaControlLowBrush" Color="{StaticResource CalcitaControlLowColor}" />
			<SolidColorBrush x:Key="CalcitaControlMidBrush" Color="{StaticResource CalcitaControlMidColor}" />
			<SolidColorBrush x:Key="CalcitaControlMidHighBrush" Color="{StaticResource CalcitaControlMidHighColor}" />
			<SolidColorBrush x:Key="CalcitaControlHighBrush" Color="{StaticResource CalcitaControlHighColor}" />
			<SolidColorBrush x:Key="CalcitaControlVeryHighBrush" Color="{StaticResource CalcitaControlVeryHighColor}" />
			<SolidColorBrush x:Key="CalcitaControlHighlightLowBrush" Color="{StaticResource CalcitaControlHighlightLowColor}" />
			<SolidColorBrush x:Key="CalcitaControlHighlightMidBrush" Color="{StaticResource CalcitaControlHighlightMidColor}" />
			<SolidColorBrush x:Key="CalcitaControlHighlightHighBrush" Color="{StaticResource CalcitaControlHighlightHighColor}" />
			<SolidColorBrush x:Key="CalcitaForegroundBrush" Color="{StaticResource CalcitaForegroundColor}" />
			<SolidColorBrush x:Key="CalcitaHighlightBrush" Color="{StaticResource CalcitaHighlightColor}" />
			<SolidColorBrush x:Key="CalcitaHighlightBrush2" Color="{StaticResource CalcitaHighlightColor2}" />
			
			<SolidColorBrush x:Key="CalcitaTabSelectedBackgroundBrush" Color="{StaticResource CalcitaBackgroundColor}" />
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>
	<FontFamily x:Key="ContentControlThemeFontFamily">fonts:Inter#Inter, $Default</FontFamily>
	<Color x:Key="CalcitaAccentColor">#CC119EDA</Color>
	<Color x:Key="CalcitaAccentColor2">#99119EDA</Color>
	<Color x:Key="CalcitaAccentColor3">#66119EDA</Color>
	<Color x:Key="CalcitaAccentColor4">#33119EDA</Color>
	<Color x:Key="CalcitaForegroundLowColor">#FF808080</Color>
	<Color x:Key="CalcitaHighlightForegroundColor">#FFFFFFFF</Color>
	<Color x:Key="CalcitaErrorColor">#FFFF0000</Color>
	<Color x:Key="CalcitaErrorLowColor">#10FF0000</Color>
	<SolidColorBrush x:Key="CalcitaHighlightForegroundBrush" Color="{StaticResource CalcitaHighlightForegroundColor}" />
	<SolidColorBrush x:Key="CalcitaForegroundLowBrush" Color="{StaticResource CalcitaForegroundLowColor}" />
	<SolidColorBrush x:Key="CalcitaAccentBrush2" Color="{StaticResource CalcitaAccentColor2}" />
	<SolidColorBrush x:Key="CalcitaAccentBrush3" Color="{StaticResource CalcitaAccentColor3}" />
	<SolidColorBrush x:Key="CalcitaAccentBrush4" Color="{StaticResource CalcitaAccentColor4}" />
	<SolidColorBrush x:Key="CalcitaAccentBrush" Color="{StaticResource CalcitaAccentColor}" />
	<SolidColorBrush x:Key="CalcitaErrorBrush" Color="{StaticResource CalcitaErrorColor}" />
	<SolidColorBrush x:Key="CalcitaErrorLowBrush" Color="{StaticResource CalcitaErrorLowColor}" />
	

	<Thickness x:Key="CalcitaBorderThickness">1</Thickness>
	<sys:Double x:Key="CalcitaDisabledOpacity">0.5</sys:Double>

	<sys:Double x:Key="CalcitaFontSizeSmall">10</sys:Double>
	<sys:Double x:Key="CalcitaFontSizeNormal">12</sys:Double>
	<sys:Double x:Key="CalcitaFontSizeLarge">16</sys:Double>

	<sys:Double x:Key="CalcitaScrollBarThickness">18</sys:Double>
	<sys:Double x:Key="CalcitaScrollBarThumbThickness">8</sys:Double>

	<sys:Double x:Key="CalcitaIconElementThemeHeight">20</sys:Double>
	<sys:Double x:Key="CalcitaIconElementThemeWidth">20</sys:Double>

	<sys:Double x:Key="CalcitaTextControlPlaceholderOpacity">0.5</sys:Double>
</ResourceDictionary>
