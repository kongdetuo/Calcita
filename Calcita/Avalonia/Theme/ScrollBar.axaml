<ResourceDictionary xmlns="https://github.com/avaloniaui"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<ControlTheme x:Key="CalcitaScrollBarTheme"
				  TargetType="ScrollBar">
		<Setter Property="Cursor" Value="Arrow" />

		<Style Selector="^:horizontal">
			<Setter Property="Height" Value="{DynamicResource CalcitaScrollBarThickness}" />
			<Setter Property="Template">
				<ControlTemplate>
					<Border Background="{DynamicResource CalcitaControlMidBrush}"
							UseLayoutRounding="False">
						<Grid ColumnDefinitions="Auto,*,Auto">
							<RepeatButton Name="PART_LineUpButton"
										  Grid.Row="0"
										  Grid.Column="0"
										  MinWidth="{DynamicResource CalcitaScrollBarThickness}"
										  VerticalAlignment="Center"
										  Classes="repeat"
										  Focusable="False"
										  AutomationProperties.Name="Column left">
								<Path Data="M 4 0 L 4 8 L 0 4 Z" />
							</RepeatButton>
							<Track Grid.Row="1"
								   Grid.Column="1"
								   Maximum="{TemplateBinding Maximum}"
								   Minimum="{TemplateBinding Minimum}"
								   Orientation="{TemplateBinding Orientation}"
								   ViewportSize="{TemplateBinding ViewportSize}"
								   DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
								   Value="{TemplateBinding Value, Mode=TwoWay}">
								<Track.DecreaseButton>
									<RepeatButton Name="PART_PageUpButton"
												  Classes="repeattrack"
												  Focusable="False"
												  AutomationProperties.Name="Page left"/>
								</Track.DecreaseButton>
								<Track.IncreaseButton>
									<RepeatButton Name="PART_PageDownButton"
												  Classes="repeattrack"
												  Focusable="False"
												  AutomationProperties.Name="Page right"/>
								</Track.IncreaseButton>
								<Thumb Name="thumb"
									   AutomationProperties.Name="Position"/>
							</Track>
							<RepeatButton Name="PART_LineDownButton"
										  Grid.Row="2"
										  Grid.Column="2"
										  MinWidth="{DynamicResource CalcitaScrollBarThickness}"
										  VerticalAlignment="Center"
										  Classes="repeat"
										  Focusable="False"
										  AutomationProperties.Name="Column right">
								<Path Data="M 0 0 L 4 4 L 0 8 Z" />
							</RepeatButton>
						</Grid>
					</Border>
				</ControlTemplate>
			</Setter>
		</Style>
		<Style Selector="^:vertical">
			<Setter Property="Width" Value="{DynamicResource CalcitaScrollBarThickness}" />
			<Setter Property="Template">
				<ControlTemplate>
					<Border Background="{DynamicResource CalcitaControlMidBrush}"
							UseLayoutRounding="False">
						<Grid RowDefinitions="Auto,*,Auto">
							<RepeatButton Name="PART_LineUpButton"
										  Grid.Row="0"
										  MinHeight="{DynamicResource CalcitaScrollBarThickness}"
										  HorizontalAlignment="Center"
										  Classes="repeat"
										  Focusable="False"
										  AutomationProperties.Name="Line up">
								<Path Data="M 0 4 L 8 4 L 4 0 Z" />
							</RepeatButton>
							<Track Grid.Row="1"
								   Grid.Column="1"
								   IsDirectionReversed="True"
								   Maximum="{TemplateBinding Maximum}"
								   Minimum="{TemplateBinding Minimum}"
								   Orientation="{TemplateBinding Orientation}"
								   ViewportSize="{TemplateBinding ViewportSize}"
								   DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
								   Value="{TemplateBinding Value, Mode=TwoWay}">
								<Track.DecreaseButton>
									<RepeatButton Name="PART_PageUpButton"
												  Classes="repeattrack"
												  Focusable="False"
												  AutomationProperties.Name="Page up"/>
								</Track.DecreaseButton>
								<Track.IncreaseButton>
									<RepeatButton Name="PART_PageDownButton"
												  Classes="repeattrack"
												  Focusable="False"
												  AutomationProperties.Name="Page down"/>
								</Track.IncreaseButton>
								<Thumb Name="thumb"
									   AutomationProperties.Name="Position"/>
							</Track>
							<RepeatButton Name="PART_LineDownButton"
										  Grid.Row="2"
										  Grid.Column="2"
										  MinHeight="{DynamicResource CalcitaScrollBarThickness}"
										  HorizontalAlignment="Center"
										  Classes="repeat"
										  Focusable="False"
										  AutomationProperties.Name="Line down">
								<Path Data="M 0 0 L 4 4 L 8 0 Z" />
							</RepeatButton>
						</Grid>
					</Border>
				</ControlTemplate>
			</Setter>
		</Style>
		<Style Selector="^ /template/ RepeatButton">
			<Setter Property="Theme" Value="{DynamicResource CalcitaRepeatButtonTheme}"/>
		</Style>
		<Style Selector="^ /template/ Thumb#thumb">
			<Setter Property="Background" Value="{DynamicResource CalcitaControlMidHighBrush}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate>
						<Border Background="{TemplateBinding Background}" />
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style Selector="^ /template/ Thumb#thumb:pointerover">
			<Setter Property="Background" Value="{DynamicResource CalcitaControlHighBrush}" />
		</Style>
		<Style Selector="^ /template/ Thumb#thumb:pressed">
			<Setter Property="Background" Value="{DynamicResource CalcitaControlVeryHighBrush}" />
		</Style>
		<Style Selector="^:horizontal /template/ Thumb#thumb">
			<Setter Property="MinWidth" Value="{DynamicResource CalcitaScrollBarThickness}" />
			<Setter Property="Height" Value="{DynamicResource CalcitaScrollBarThumbThickness}" />
		</Style>
		<Style Selector="^:vertical /template/ Thumb#thumb">
			<Setter Property="MinHeight" Value="{DynamicResource CalcitaScrollBarThickness}" />
			<Setter Property="Width" Value="{DynamicResource CalcitaScrollBarThumbThickness}" />
		</Style>
		<Style Selector="^ /template/ RepeatButton.repeat">
			<Setter Property="Padding" Value="2" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>
		<Style Selector="^ /template/ RepeatButton.repeattrack">
			<Setter Property="Template">
				<ControlTemplate>
					<Border Background="{TemplateBinding Background}" />
				</ControlTemplate>
			</Setter>
		</Style>

		<Style Selector="^ /template/ RepeatButton > Path">
			<Setter Property="Fill" Value="{DynamicResource CalcitaForegroundLowBrush}" />
		</Style>

		<Style Selector="^ /template/ RepeatButton:pointerover > Path">
			<Setter Property="Fill" Value="{DynamicResource CalcitaAccentBrush}" />
		</Style>
	</ControlTheme>
</ResourceDictionary>
