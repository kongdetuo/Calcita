<Styles xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Design.PreviewWith>
		<Border Padding="20">
			<!-- Add Controls for Previewer Here -->
		</Border>
	</Design.PreviewWith>

	<Styles.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<MergeResourceInclude Source="/Avalonia/Theme/Base.axaml" />
				<MergeResourceInclude Source="/Avalonia/Theme/Button.axaml" />
				<MergeResourceInclude Source="/Avalonia/Theme/RepeatButton.axaml" />
				<MergeResourceInclude Source="/Avalonia/Theme/ScrollBar.axaml" />
				<MergeResourceInclude Source="/Avalonia/Theme/SheetTabControl.axaml" />
				<MergeResourceInclude Source="/Avalonia/Theme/CalcitaControl.axaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Styles.Resources>
</Styles>
